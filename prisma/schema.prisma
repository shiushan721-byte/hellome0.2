generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  draft
  queued
  awaiting_input
  running
  waiting_confirmation
  completed
  failed
  cancelled
}

enum TaskExecutionMode {
  backend_silent
  local_debug
}

enum ArtifactType {
  video
  image
  script
  report
  audio
}

enum LedgerStatus {
  reserved
  settled
  refunded
  failed
}

enum SkillStatus {
  draft
  published
  archived
}

enum GnomicBindingStatus {
  active
  disabled
}

model User {
  id          String      @id @default(cuid())
  externalId  String      @unique
  displayName String?
  email       String?
  phone       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspaces  Workspace[]
  tasks       Task[]
  devices     HermesDevice[]
  ledgers     UsageLedger[]
  topups      BillingTopup[]
  skills      Skill[]
  adminMeta   UserProfileAdminMeta?
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id                String            @id @default(cuid())
  name              String
  agentType         String
  status            TaskStatus
  executionMode     TaskExecutionMode @default(backend_silent)
  pauseReasonType   String?
  pauseReasonMessage String?
  resumeMode        String?
  recoverable       Boolean           @default(false)
  artifactsPreserved Json?
  willChargeAgain   Boolean?
  showcaseStage     Json?
  skillId           String?
  skillVersionId    String?
  executionGrantId  String?           @unique
  /// 🆕 v1.1: Hermes skill 返回的动态参数 schema (前端渲染用)
  schemaPayload     Json?
  /// 🆕 v1.1: schema 就绪时间,前端据此判断是否还在等 Hermes
  schemaReadyAt     DateTime?
  /// 🆕 v1.1: 用户填写的结构化答案 (替代原 TaskInput 7 字段扁平化)
  structuredAnswers Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?
  estimatedTokenMin Int               @default(0)
  estimatedTokenMax Int               @default(0)
  tokenUsed         Int               @default(0)
  currentTokenUsed  Int               @default(0)
  costEstimate      String?
  requiresConfirm   Boolean           @default(false)
  userId            String
  workspaceId       String?
  input             TaskInput?
  runs              TaskRun[]
  steps             TaskStep[]
  artifacts         TaskArtifact[]
  events            TaskEvent[]
  executions        HermesExecution[]
  ledgers           UsageLedger[]
  executionGrants   ExecutionGrant[]
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace         Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  skill             Skill?            @relation(fields: [skillId], references: [id], onDelete: SetNull)
  skillVersion      SkillVersion?     @relation(fields: [skillVersionId], references: [id], onDelete: SetNull)
  executionGrant    ExecutionGrant?   @relation("TaskActiveGrant", fields: [executionGrantId], references: [id], onDelete: SetNull)
}

model TaskInput {
  id             String   @id @default(cuid())
  taskId         String   @unique
  productImage   String?
  productName    String?
  talentImage    String?
  sellingPoint   String
  platform       String
  effectGoal     String
  referenceUrl   String?
  payload        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskRun {
  id          String            @id @default(cuid())
  taskId      String
  status      TaskStatus
  mode        TaskExecutionMode @default(backend_silent)
  attempt     Int               @default(1)
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskStep {
  id         String   @id @default(cuid())
  taskId      String
  key         String
  title       String
  orderIndex  Int
  status      String
  detail      String?
  tokenUsed   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, key])
  @@index([taskId, orderIndex])
}

model TaskArtifact {
  id          String       @id @default(cuid())
  taskId       String
  type         ArtifactType
  label        String
  fileName     String
  url          String?
  mimeType     String?
  sizeBytes    Int?
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskEvent {
  id         String   @id @default(cuid())
  taskId      String
  type        String
  level       String
  message     String
  metadata    Json?
  createdAt   DateTime @default(now())
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model HermesExecution {
  id           String            @id @default(cuid())
  taskId        String
  mode          TaskExecutionMode @default(backend_silent)
  recipe        String
  requestId     String?
  command       String?
  stdout        String?
  stderr        String?
  status        String
  pauseReasonType String?
  pauseReasonMessage String?
  resumeMode    String?
  recoverable   Boolean           @default(false)
  artifactsPreserved Json?
  willChargeAgain Boolean?
  skillId       String?
  skillVersionId String?
  skillChecksum String?
  deviceId      String?
  grantId       String?
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  task          Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ExecutionGrant {
  id               String    @id @default(cuid())
  taskId           String
  skillId          String
  skillVersionId   String
  deviceId         String?
  grantTokenHash   String
  allowedProviders Json?
  allowedModels    Json?
  tokenBudgetMax   Int       @default(30000)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  activeForTask    Task?     @relation("TaskActiveGrant")
  skill            Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillVersion     SkillVersion @relation(fields: [skillVersionId], references: [id], onDelete: Cascade)
  device           HermesDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([grantTokenHash])
}

model UsageLedger {
  id          String       @id @default(cuid())
  userId       String
  taskId       String?
  tokenUsed    Int          @default(0)
  videoCost    String?
  status       LedgerStatus @default(settled)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model BillingTopup {
  id          String   @id @default(cuid())
  userId      String
  tokenAmount Int
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model HermesDevice {
  id            String   @id @default(cuid())
  userId        String
  deviceName    String
  os            String
  version       String?
  status        String
  lastSeenAt    DateTime?
  debugEnabled  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  executionGrants ExecutionGrant[]
}

model Skill {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  description    String?
  category       String         @default("ugc_video")
  status         SkillStatus    @default(draft)
  ownerId        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  publishedAt    DateTime?
  currentVersion Int            @default(1)
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions       SkillVersion[]
  debugRuns      SkillDebugRun[]
  tasks          Task[]
  executionGrants ExecutionGrant[]
}

model SkillVersion {
  id                   String      @id @default(cuid())
  skillId              String
  versionNumber        Int
  versionLabel         String
  status               SkillStatus @default(draft)
  title                String
  summary              String?
  checksum             String      @default("")
  sourceType           String?
  baseVersionId        String?
  inputConfig          Json?
  understandingConfig  Json?
  executionConfig      Json?
  businessFrame        Json?
  artifactConfig       Json?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  publishedAt          DateTime?
  skill                Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  debugRuns            SkillDebugRun[]
  tasks                Task[]
  executionGrants      ExecutionGrant[]

  @@unique([skillId, versionNumber])
}

model SkillDebugRun {
  id              String       @id @default(cuid())
  skillId         String
  skillVersionId  String?
  status          String
  inputPayload    Json?
  outputPayload   Json?
  logPayload      Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  skill           Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillVersion    SkillVersion? @relation(fields: [skillVersionId], references: [id], onDelete: SetNull)
}

model GnomicAccountBinding {
  id            String              @id @default(cuid())
  hellomeUserId String              @unique
  gnomicUserId  String              @unique
  phone         String?
  status        GnomicBindingStatus @default(active)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([phone])
}

model UserProfileAdminMeta {
  id             String    @id @default(cuid())
  userId         String    @unique
  status         String    @default("active")
  tags           Json?
  lastLoginAt    DateTime?
  disabledAt     DateTime?
  disabledReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GnomicSsoTicket {
  id            String   @id @default(cuid())
  ticket        String   @unique
  hellomeUserId String
  gnomicUserId  String
  redirectPath  String
  used          Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([hellomeUserId])
  @@index([expiresAt])
}

model FrontendConfig {
  id          String    @id @default(cuid())
  key         String
  name        String
  scope       String
  version     Int       @default(1)
  status      String    @default("draft")
  payload     Json
  publishedAt DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([key, version])
  @@index([scope, status])
}

model PublishRecord {
  id          String   @id @default(cuid())
  module      String
  targetKey   String
  version     Int
  title       String
  diff        Json?
  snapshot    Json
  publishedBy String
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorName  String?
  module     String
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([module, createdAt])
}

model RechargePack {
  id          String   @id @default(cuid())
  name        String
  tokenAmount Int
  bonusTokens Int      @default(0)
  priceCents  Int
  status      String   @default("draft")
  recommended Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkflowTemplate {
  id          String   @id @default(cuid())
  templateId  String   @unique
  title       String
  category    String
  coverUrl    String?
  authorName  String?
  pricePerRun Int?
  gnomicPath  String
  status      String   @default("draft")
  sortOrder   Int      @default(0)
  recommended Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Agent {
  id                      String              @id @default(cuid())
  slug                    String              @unique
  name                    String
  description             String
  detailHtml              String?
  iconUrl                 String
  category                String?
  tags                    Json?
  status                  String              @default("offline")
  currentPackageVersionId String?
  skillId                 String?
  sortOrder               Int                 @default(0)
  createdBy               String?
  updatedBy               String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  packages                AgentSkillPackage[]

  @@index([status, updatedAt])
}

model AgentSkillPackage {
  id               String   @id @default(cuid())
  agentId          String
  version          String
  fileName         String
  fileUrl          String
  fileSize         Int
  checksum         String
  manifest         Json?
  validationStatus String   @default("pending")
  validationErrors Json?
  releaseNote      String?
  skillVersionId   String?
  uploadedBy       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([agentId, createdAt])
}
